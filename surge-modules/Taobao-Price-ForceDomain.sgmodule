#!name=淘宝历史比价｜强制域名候选
#!desc=临时测试版｜基于当前抓包阻断淘宝直连IP与QUIC，尝试强制商品详情回落到域名HTTPS
#!author=doovvip
#!category=调试
#!system=ios
#!version=0.1.0
#!date=2026-08-28

# 仅用于测试新版淘宝是否能从直连 IP 回落到域名 HTTPS。
# 不建议长期启用；若淘宝页面异常请立即关闭本模块。

[Rule]
# 当前设备抓包中反复出现的淘宝/阿里直连地址段（临时、窄范围）
IP-CIDR,112.48.116.0/24,REJECT,no-resolve
IP-CIDR,112.48.140.0/24,REJECT,no-resolve
IP-CIDR,112.48.144.0/24,REJECT,no-resolve
IP-CIDR,112.48.172.0/24,REJECT,no-resolve
IP-CIDR,112.48.182.0/24,REJECT,no-resolve
IP-CIDR,112.48.241.0/24,REJECT,no-resolve
IP-CIDR,112.50.108.0/24,REJECT,no-resolve
IP-CIDR,112.51.127.0/24,REJECT,no-resolve

# 仅对淘宝/天猫域名 QUIC 做回落
AND,((DOMAIN-SUFFIX,taobao.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN-SUFFIX,tmall.com),(PROTOCOL,UDP)),REJECT

[URL Rewrite]
^https?:\/\/(?:amdc\.m\.taobao\.com|\d{1,3}(?:\.\d{1,3}){3})\/amdc\/mobileDispatch - reject

[Script]
淘宝详情接口探测 = type=http-request, pattern=^https?:\/\/(?:[^\/]+\.)?(?:taobao|tmall)\.com\/gw\/mtop\., requires-body=true, max-size=-1, timeout=10, script-path=https://raw.githubusercontent.com/doovvip/sublink-worker/main/surge-modules/scripts/taobao_price_auto.surge.js, script-update-interval=86400

[MITM]
hostname = %APPEND% *.taobao.com, *.tmall.com
