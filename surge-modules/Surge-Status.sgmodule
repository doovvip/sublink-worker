#!name=Surge 状态面板
#!desc=轻量本地状态面板｜手动刷新才运行｜不测速、不查公网 IP、不定时、不使用 MITM
#!author=doovvip integration
#!category=工具
#!system=ios
#!version=1.0.0
#!date=2026-08-31

# 设计原则：
# 1. 纯本地读取 $network / $environment / $surge.selectGroupDetails()。
# 2. 不发起任何 HTTP 请求。
# 3. 不配置 update-interval，不自动刷新。
# 4. 不使用 MITM / URL Rewrite / Rule。
# 5. 仅在面板手动刷新时运行一次，并由 Surge 缓存上次结果。

[Panel]
Surge状态 = title="Surge 状态", content="点击刷新查看当前网络与主要策略", style=info, script-name=Surge状态

[Script]
Surge状态 = type=generic, engine=jsc, timeout=3, script-path=https://raw.githubusercontent.com/doovvip/sublink-worker/main/surge-modules/scripts/surge-status.js, script-update-interval=604800
