#!name=红果短剧｜全功能实验版 V1.0.0
#!desc=Surge 实验模块｜去广告 + VIP响应尝试 + 下载限制尝试 + 清晰度权限尝试｜仅实验，不纳入正式母版
#!author=doovvip integration
#!category=实验
#!system=iOS
#!version=1.0.0
#!date=2026-08-31

[Rule]
DOMAIN,p6-ad-sign.byteimg.com,REJECT,pre-matching
DOMAIN,p9-ad-sign.byteimg.com,REJECT,pre-matching
DOMAIN,api-access.pangolin-sdk-toutiao.com,REJECT,pre-matching
DOMAIN,api-access.pangolin-sdk-toutiao-b.com,REJECT,pre-matching
DOMAIN,api-access.pangolin-sdk-toutiao1.com,REJECT,pre-matching
DOMAIN,log-api.pangolin-sdk-toutiao.com,REJECT,pre-matching
DOMAIN,log-api.pangolin-sdk-toutiao-b.com,REJECT,pre-matching
DOMAIN-SUFFIX,pglstatp-toutiao.com,REJECT,pre-matching

[URL Rewrite]
^https?:\/\/[^\/]+\.pangolin-sdk-toutiao\.com\/api\/ad\/union\/sdk\/(?:get_ads|stats|settings)\/ - reject
^https?:\/\/[^\/]+\.(?:pglstatp-toutiao|pstatp)\.com\/(?:obj|img)\/(?:ad-app-package|ad)\/.* - reject
^https?:\/\/[^\/]+\.(?:pglstatp-toutiao|pstatp)\.com\/obj\/ad-pattern\/renderer(?:\/|\?|$).* - reject
^https?:\/\/[^\/]+\.pstatp\.com\/obj\/mosaic-legacy\/.*[?&]from=ad(?:&|$).* - reject
^https?:\/\/[^\/]+\.snssdk\.com\/api\/ad\/(?:.*) - reject
^https?:\/\/[^\/]+\.byteimg\.com\/(?:ad-app-package|web\.business\.image)(?:\/|\?|$).* - reject

[Script]
HongGuo_VIP = type=http-response,pattern=^https?:\/\/[^\/]+\.(?:snssdk|ixigua|bytedance)\.com\/.*(?:vip|member|privilege|user|account).*,requires-body=true,max-size=0,script-path=https://raw.githubusercontent.com/doovvip/sublink-worker/main/surge-scripts/hongguo-vip.js
HongGuo_Download = type=http-response,pattern=^https?:\/\/[^\/]+\.(?:snssdk|ixigua|bytedance)\.com\/.*(?:download|ssconfig|ab|config).*,requires-body=true,max-size=0,script-path=https://raw.githubusercontent.com/doovvip/sublink-worker/main/surge-scripts/hongguo-download.js
HongGuo_Quality = type=http-response,pattern=^https?:\/\/[^\/]+\.(?:snssdk|ixigua|bytedance)\.com\/.*(?:video|play|resolution|quality|config).*,requires-body=true,max-size=0,script-path=https://raw.githubusercontent.com/doovvip/sublink-worker/main/surge-scripts/hongguo-quality.js

[MITM]
hostname = %APPEND% *.pangolin-sdk-toutiao.com, *.pglstatp-toutiao.com, *.pstatp.com, *.snssdk.com, *.ixigua.com, *.bytedance.com

# 说明：
# 1. 去广告为网络层直接拦截。
# 2. VIP/下载/画质为响应层“命中特征后修改”，并非 Xposed 本地 Hook 的 1:1 替代。
# 3. 纯本地方法如 PrivilegeManager.isVip()、TTVideoEngine.configResolution()、xh5.f 构造器等，Surge 无法直接 Hook。
# 4. 本模块仅实验使用，不纳入正式母版或正式恢复。
