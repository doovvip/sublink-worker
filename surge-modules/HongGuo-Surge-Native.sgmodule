#!name = 红果短剧去广告
#!desc = Surge 独立维护版｜精准拦截红果广告请求与素材，不整域屏蔽正常视频 CDN
#!author = doovvip
#!category = 净化
#!system = iOS
#!version = 1.3.0
#!date = 2026-09-06

[Rule]
# Pangle ad delivery and telemetry hosts
DOMAIN,api-access.pangolin-sdk-toutiao.com,REJECT,pre-matching
DOMAIN,api-access.pangolin-sdk-toutiao-b.com,REJECT,pre-matching
DOMAIN,api-access.pangolin-sdk-toutiao1.com,REJECT,pre-matching
DOMAIN,log-api.pangolin-sdk-toutiao.com,REJECT,pre-matching
DOMAIN,log-api.pangolin-sdk-toutiao-b.com,REJECT,pre-matching
DOMAIN-SUFFIX,pangolin-sdk-toutiao.com,REJECT,pre-matching
DOMAIN-SUFFIX,pangolin-sdk-toutiao-b.com,REJECT,pre-matching
DOMAIN-SUFFIX,pangolin-sdk-toutiao1.com,REJECT,pre-matching
DOMAIN-SUFFIX,pglstatp-toutiao.com,REJECT,pre-matching

# ByteDance signed ad assets and ad API nodes
DOMAIN-SUFFIX,ad-sign.byteimg.com,REJECT,pre-matching
DOMAIN,ads3-normal-hl.zijieapi.com,REJECT,pre-matching
DOMAIN,ads3-normal.zijieapi.com,REJECT,pre-matching
DOMAIN,ads5-normal-hl.zijieapi.com,REJECT,pre-matching
DOMAIN,ads5-normal.zijieapi.com,REJECT,pre-matching

# HongGuo/FQNovel ad scheduling, reporting and ad video nodes
DOMAIN-SUFFIX,misc-lq.fqnovel.com,REJECT,pre-matching
DOMAIN-SUFFIX,reading-ad.qznovelvod.com,REJECT,pre-matching
DOMAIN-SUFFIX,iosreadingvideo.qznovelvod.com,REJECT,pre-matching

[URL Rewrite]
# Only reject known ad paths on shared CDN/API domains
^https?:\/\/(?:[^\/]+\.)?pangolin-sdk-toutiao(?:-b|1)?\.com\/api\/ad\/union\/sdk\/(?:get_ads|settings|stats)(?:\/|\?|$).* - reject
^https?:\/\/[^\/]+\.(?:pglstatp-toutiao|pstatp)\.com\/(?:obj|img)\/(?:ad-app-package|ad)(?:\/|\?|$).* - reject
^https?:\/\/[^\/]+\.(?:pglstatp-toutiao|pstatp)\.com\/obj\/ad-pattern\/renderer(?:\/|\?|$).* - reject
^https?:\/\/[^\/]+\.pstatp\.com\/obj\/mosaic-legacy\/.*[?&]from=ad(?:&|$).* - reject
^https?:\/\/[^\/]+\.snssdk\.com\/api\/ad\/(?:.*) - reject
^https?:\/\/[^\/]+\.zijieapi\.com\/(?:api\/ad|ad\/union|advertisement)(?:\/|\?|$).* - reject
^https?:\/\/[^\/]+\.byteimg\.com\/(?:ad-app-package|web\.business\.image)(?:\/|\?|$).* - reject
^https?:\/\/lf-cdn-tos\.bytescm\.com\/obj\/static\/ad(?:\/|\?|$).* - reject

[MITM]
hostname = %APPEND% *.pangolin-sdk-toutiao.com, *.pangolin-sdk-toutiao-b.com, *.pangolin-sdk-toutiao1.com, *.pglstatp-toutiao.com, *.pstatp.com, *.snssdk.com, *.zijieapi.com, *.byteimg.com, lf-cdn-tos.bytescm.com

# Design constraints:
# 1. Keep this module ad-only; VIP, download and quality experiments are intentionally excluded.
# 2. Shared content domains such as pstatp.com, byteimg.com and snssdk.com are filtered by URL path only.
# 3. Normal video/image hosts such as douyinpic.com and ecombdimg.com remain untouched.
