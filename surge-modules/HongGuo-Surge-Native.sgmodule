#!name = R2｜红果短剧
#!desc=Surge R2 工作版｜加强播放中插广告拦截；下载/画质保留当前响应实验逻辑
#!author=doovvip integration
#!category=净化
#!system=iOS
#!version=1.3.0
#!date=2026-09-05

[Rule]
DOMAIN,p3-ad-sign.byteimg.com,REJECT,pre-matching
DOMAIN,p6-ad-sign.byteimg.com,REJECT,pre-matching
DOMAIN,p9-ad-sign.byteimg.com,REJECT,pre-matching
DOMAIN,ads3-normal-hl.zijieapi.com,REJECT,pre-matching
DOMAIN,ads3-normal.zijieapi.com,REJECT,pre-matching
DOMAIN,ads5-normal-hl.zijieapi.com,REJECT,pre-matching
DOMAIN,ads5-normal.zijieapi.com,REJECT,pre-matching
DOMAIN,api-access.pangolin-sdk-toutiao.com,REJECT,pre-matching
DOMAIN,api-access.pangolin-sdk-toutiao-b.com,REJECT,pre-matching
DOMAIN,api-access.pangolin-sdk-toutiao1.com,REJECT,pre-matching
DOMAIN,log-api.pangolin-sdk-toutiao.com,REJECT,pre-matching
DOMAIN,log-api.pangolin-sdk-toutiao-b.com,REJECT,pre-matching
DOMAIN-SUFFIX,pangolin-sdk-toutiao.com,REJECT,pre-matching
DOMAIN-SUFFIX,pangolin-sdk-toutiao-b.com,REJECT,pre-matching
DOMAIN-SUFFIX,pangolin-sdk-toutiao1.com,REJECT,pre-matching
DOMAIN-SUFFIX,pglstatp-toutiao.com,REJECT,pre-matching
DOMAIN-SUFFIX,ad-sign.byteimg.com,REJECT,pre-matching
DOMAIN,mi.gdt.qq.com,REJECT,pre-matching
DOMAIN,sdk.e.qq.com,REJECT,pre-matching
DOMAIN,open.e.kuaishou.com,REJECT,pre-matching
DOMAIN-SUFFIX,anythinktech.com,REJECT,pre-matching

[URL Rewrite]
^https?:\/\/[^\/]+\.pangolin-sdk-toutiao\.com\/api\/ad\/union\/sdk\/(?:get_ads|stats|settings)\/ - reject
^https?:\/\/[^\/]+\.(?:pglstatp-toutiao|pstatp)\.com\/(?:obj|img)\/(?:ad-app-package|ad)\/.* - reject
^https?:\/\/[^\/]+\.(?:pglstatp-toutiao|pstatp)\.com\/obj\/ad-pattern\/renderer(?:\/|\?|$).* - reject
^https?:\/\/[^\/]+\.pstatp\.com\/obj\/mosaic-legacy\/.*[?&]from=ad(?:&|$).* - reject
^https?:\/\/[^\/]+\.snssdk\.com\/api\/ad\/(?:.*) - reject
^https?:\/\/[^\/]+\.byteimg\.com\/(?:ad-app-package|web\.business\.image)(?:\/|\?|$).* - reject
^https?:\/\/lf-cdn-tos\.bytescm\.com\/obj\/static\/ad(?:\/|\?|$).* - reject

[Script]
HongGuo_Download = type=http-response,pattern=^https?:\/\/[^\/]+\.(?:snssdk|ixigua|bytedance)\.com\/.*(?:download|ssconfig|ab|config).*,requires-body=true,max-size=0,script-path=https://raw.githubusercontent.com/doovvip/sublink-worker/b3612e647c70e05ebff57d818c2bd30d5c28c51e/permanent-assets/r2-2026-09-03/scripts/hongguo-download.js, script-update-interval=86400
HongGuo_Quality = type=http-response,pattern=^https?:\/\/[^\/]+\.(?:snssdk|ixigua|bytedance)\.com\/.*(?:video|play|resolution|quality|config).*,requires-body=true,max-size=0,script-path=https://raw.githubusercontent.com/doovvip/sublink-worker/b3612e647c70e05ebff57d818c2bd30d5c28c51e/permanent-assets/r2-2026-09-03/scripts/hongguo-quality.js, script-update-interval=86400

[MITM]
hostname = %APPEND% *.pangolin-sdk-toutiao.com, *.pangolin-sdk-toutiao-b.com, *.pangolin-sdk-toutiao1.com, *.pglstatp-toutiao.com, *.pstatp.com, *.snssdk.com, *.ixigua.com, *.bytedance.com, lf-cdn-tos.bytescm.com

# 正式口径：
# 1. 去广告：V1.3.0 针对播放中插广告补齐穿山甲/Gromore 域名族及常见聚合广告备用 SDK。
# 2. VIP：当前 Surge 响应脚本基本无效，为减少无效 MITM/脚本开销已移除。
# 3. 下载/画质：保留当前响应层实现，后续若实机确认无效再单独移除，不影响去广告主功能。
# 4. 该文件自 2026-08-31 起纳入正式母版与正式恢复清单。
