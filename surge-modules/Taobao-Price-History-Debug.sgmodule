#!name=淘宝历史比价｜Debug V2
#!desc=临时诊断版｜强制关闭淘宝商品链路 HTTPDNS/QUIC 后探测真实接口
#!author=doovvip
#!category=淘宝
#!system=ios
#!version=2.0.0-debug
#!date=2026-08-28

# 临时诊断模块：只用于定位新版淘宝商品详情接口。
# 逻辑：先处理 AMDC/HTTPDNS，让商品请求回到可被 Surge MITM 的域名链路；同时阻断淘宝 QUIC，再探测 host + path。
# 通知不读取或展示 query/body/header。

[Rule]
AND,((DOMAIN-SUFFIX,taobao.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN-SUFFIX,tmall.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN-SUFFIX,tb.cn),(PROTOCOL,UDP)),REJECT

[Script]
# 先沿用已验证的老淘宝 AMDC 思路：清掉商品网关 HTTPDNS IP，迫使回域名访问
淘宝AMDC请求处理 = type=http-request, pattern=^https?:\/\/.+\/amdc\/mobileDispatch(?:\?.*)?$, requires-body=true, max-size=-1, timeout=15, script-path=https://raw.githubusercontent.com/doovvip/sublink-worker/main/surge-modules/scripts/taobao_price.surge.js, script-update-interval=3600
淘宝AMDC响应处理 = type=http-response, pattern=^https?:\/\/.+\/amdc\/mobileDispatch(?:\?.*)?$, requires-body=true, max-size=-1, timeout=15, script-path=https://raw.githubusercontent.com/doovvip/sublink-worker/main/surge-modules/scripts/taobao_price.surge.js, script-update-interval=3600

# 探测新版淘宝/天猫商品链路
淘宝接口探测 = type=http-request, pattern=^https?:\/\/[^\/]*(?:taobao|tmall|tb\.cn|alicdn|alibaba|aliyun|mmstat)[^\/]*\/.*, requires-body=false, timeout=10, script-path=https://raw.githubusercontent.com/doovvip/sublink-worker/main/surge-modules/scripts/taobao_price_debug.surge.js, script-update-interval=3600

[MITM]
hostname = %APPEND% *.taobao.com, *.tmall.com, *.tb.cn, *.alicdn.com, *.alibaba.com, *.aliyun.com, *.mmstat.com
