#!name=淘宝历史比价｜Debug
#!desc=临时诊断版｜只探测淘宝商品详情相关请求｜不读取或上报请求正文/参数
#!author=doovvip
#!category=淘宝
#!system=ios
#!version=1.0.0-debug
#!date=2026-08-28

# 临时诊断模块：用于确认新版淘宝当前实际商品详情接口。
# 只通知 host + path，不显示 query/body/header。

[Script]
淘宝接口探测 = type=http-request, pattern=^https?:\/\/[^\/]*(?:taobao|tmall|alicdn|alibaba)[^\/]*\/.*, requires-body=false, timeout=10, script-path=https://raw.githubusercontent.com/doovvip/sublink-worker/main/surge-modules/scripts/taobao_price_debug.surge.js, script-update-interval=3600

[MITM]
hostname = %APPEND% *.taobao.com, *.tmall.com, *.alicdn.com, *.alibaba.com
