#!name=淘宝历史比价｜V1.1.0
#!desc=Surge版｜淘宝商品详情历史价格｜自托管脚本｜独立模块
#!author=doovvip integration
#!category=淘宝
#!system=ios
#!version=1.1.0
#!date=2026-08-28

# 候选测试版：先实机验证，确认后再定为母版。
# 逻辑参考公开社区长期使用的淘宝 detail 接口 + 历史价格服务方案，脚本已重新实现并自托管。
# 不依赖慢慢买 App CK；不修改 Surge 主配置。

[Script]
淘宝比价.AMDC请求 = type=http-request, pattern=^https?:\/\/.+\/amdc\/mobileDispatch, requires-body=true, max-size=0, timeout=30, script-path=https://raw.githubusercontent.com/doovvip/sublink-worker/main/surge-modules/scripts/taobao_price_v2.surge.js, script-update-interval=86400
淘宝比价.AMDC响应 = type=http-response, pattern=^https?:\/\/.+\/amdc\/mobileDispatch, requires-body=true, max-size=0, timeout=30, script-path=https://raw.githubusercontent.com/doovvip/sublink-worker/main/surge-modules/scripts/taobao_price_v2.surge.js, script-update-interval=86400
淘宝历史比价 = type=http-response, pattern=^https?:\/\/(?:trade-acs|guide-acs|acs|h5api)\.m\.taobao\.com\/(?:gw|h5)\/mtop\.taobao\.detail\.getdetail(?:\/[^?]*)?(?:\?.*)?$, requires-body=true, max-size=0, timeout=30, script-path=https://raw.githubusercontent.com/doovvip/sublink-worker/main/surge-modules/scripts/taobao_price_v2.surge.js, script-update-interval=86400

[MITM]
hostname = %APPEND% trade-acs.m.taobao.com, guide-acs.m.taobao.com, acs.m.taobao.com, h5api.m.taobao.com, amdc.m.taobao.com
