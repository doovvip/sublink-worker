#!name=墨鱼去开屏2.0去广告@ddgksf2013
#!desc=Surge 原生稳定基线｜恢复到已实机确认可用版本｜无 QX 模拟、无脚本运行层
#!author=ddgksf2013 / Surge native optimization
#!category=去广告
#!system=ios

# ============================================================
# 母版状态
# ============================================================
# 本文件恢复为用户已实机确认可用的稳定版本。
# 美图秀秀 / 喜马拉雅 / V380 Pro 的新增规则不进入本母版，后续只在实验版验证。
# ============================================================

# ============================================================
# 设计思路
# ============================================================
# 1. 本模块只做“通用开屏/弹窗广告”处理，不接管 B站、酷我、喜马拉雅。
# 2. 不模拟 Quantumult X，不使用 $task / $prefs / $notify，不运行任何 JS。
# 3. 能用 Surge 原生 URL Rewrite 直接拒绝的，直接拒绝。
# 4. 只有必须返回固定 JSON 的接口才使用 Map Local。
# 5. 同域、同返回方式、同业务含义的规则做小范围合并；不使用巨大正则。
# 6. 不扩大 MITM，不增加通用广告 SDK 域名，不碰登录/支付/账号等业务接口。
# 7. 当前跑通版保留为回滚基线；本候选版实机确认后再晋升为母版。
#
# 优化点：
# - URL Rewrite：20 条 -> 17 条
# - Map Local：2 条 -> 1 条
# - Script：0 条（保持 0）
# - QX 兼容层：0
# - B站/酷我/喜马拉雅重叠：0
# ============================================================

[URL Rewrite]
# ===== 百度网盘 =====
^https?:\/\/pan\.baidu\.com\/(?:act\/v\d+\/(?:bchannel|welfare)\/list|rest\/2\.0\/pcs\/ad) - reject-200

# ===== 山姆会员商店 =====
^https?:\/\/api-sams\.walmartmobile\.cn\/api\/v1\/sams\/sams-user\/(?:window\/getGoUpPlus|screen_promotion\/get) - reject-200

# ===== 淘宝 =====
^https?:\/\/guide-acs\.m\.taobao\.com\/gw\/mtop\.taobao\.wireless\.home\.splash\.awesome\.get - reject-200

# ===== 京东 =====
^https?:\/\/api\.m\.jd\.com\/client\.action\?functionId=(?:start|queryMaterialAdverts) - reject-200
^https?:\/\/(?:bdsp-x|dsp-x)\.jd\.com\/adx\/ - reject-200

# ===== 美团 =====
^https?:\/\/peisongapi\.meituan\.com\/client\/getInitiateImage - reject-200
^https?:\/\/img\.meituan\.net\/(?:adunion|display|midas)\/\w+\.(?:gif|jpg|jpg\.webp)$ - reject-200
^https?:\/\/(?:s3plus|flowplus)\.meituan\.net\/v\d+\/\w+\/linglong\/\w+\.(?:gif|jpg|mp4) - reject-200
^https?:\/\/p\d\.meituan\.net\/(?:(?:bizad|wmbanner)\/\w+\.jpg|movie\/\w+\.jpg\?may_covertWebp) - reject-200

# ===== 闲鱼（备用） =====
^https?:\/\/acs\.m\.goofish\.com\/gw\/mtop[^/]*splash\.ads - reject-200

# ===== 拼多多（备用） =====
^https?:\/\/api\.(?:pinduoduo|yangkeduo)\.com\/api\/cappuccino\/splash - reject-200

# ===== 菜鸟（备用） =====
^https?:\/\/cn-acs\.m\.cainiao\.com\/gw\/mtop\.cainiao\.guoguo\.nbnetflow\.ads\.(?:show|mshow)\.cn\/ - reject-200
^https?:\/\/iyes\.youku\.com\/uts\/v\d+\/start - reject-200

# ===== 飞猪（备用） =====
^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.fliggy\.crm\.screen\.(?:allresource|availablesplashstrategies) - reject-200

# ===== 顺丰（备用） =====
^https?:\/\/ccsp-egmas\.sf-express\.com\/cx-app-base\/base\/app\/appVersion\/detectionUpgrade - reject-200
^https:\/\/ccsp-egmas\.sf-express\.com\/cx-app-base\/base\/app\/ad\/queryAdImages - reject-200
^https?:\/\/shopic\.sf-express\.com\/crm\/mobile\/common\/flashscreen - reject-200

[Map Local]
# 百度网盘：两个接口都要求返回空 JSON，合并为一个原生 Map Local
^https:\/\/pan\.baidu\.com\/(?:act\/api\/activityentry|buy\/ad\/conf\?.*type=splashMode) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% pan.baidu.com, api-sams.walmartmobile.cn, guide-acs.m.taobao.com, api.m.jd.com, bdsp-x.jd.com, dsp-x.jd.com, peisongapi.meituan.com, img.meituan.net, s3plus.meituan.net, flowplus.meituan.net, p*.meituan.net, acs.m.goofish.com, api.pinduoduo.com, api.yangkeduo.com, cn-acs.m.cainiao.com, iyes.youku.com, acs.m.taobao.com, ccsp-egmas.sf-express.com, shopic.sf-express.com
