#!name=淘宝商品ID探测｜分享链路版
#!desc=候选诊断｜V1.12.0｜改走分享/短链接链路抓商品ID，不再依赖淘宝内部详情接口
#!author=doovvip
#!category=调试
#!system=ios
#!version=1.12.0
#!date=2026-08-28

# 不修改主配置；不封IP/QUIC；不再依赖内部详情API。
# 操作：打开淘宝商品页，点一次“分享”，然后回 Surge 看面板。

[Panel]
淘宝商品ID探测面板 = title="淘宝商品ID探测", content="等待分享链路…\n打开商品页后点一次分享", style=info, script-name=淘宝探测面板, update-interval=1

[Script]
淘宝分享探测.REQ = type=http-request, pattern=^https?:\/\/(?:[^\/]+\.)?(?:taobao\.com|tmall\.com|tao\.co|tb\.cn)\/, requires-body=true, binary-body-mode=true, max-size=-1, timeout=10, script-path=https://raw.githubusercontent.com/doovvip/sublink-worker/main/surge-modules/scripts/taobao_share_probe.surge.js?v=1.12.0, script-update-interval=0
淘宝分享探测.RESP = type=http-response, pattern=^https?:\/\/(?:[^\/]+\.)?(?:taobao\.com|tmall\.com|tao\.co|tb\.cn)\/, requires-body=true, binary-body-mode=true, max-size=-1, timeout=10, script-path=https://raw.githubusercontent.com/doovvip/sublink-worker/main/surge-modules/scripts/taobao_share_probe.surge.js?v=1.12.0, script-update-interval=0
淘宝探测面板 = type=generic, script-path=https://raw.githubusercontent.com/doovvip/sublink-worker/main/surge-modules/scripts/taobao_price_probe_panel.surge.js?v=1.12.0, script-update-interval=0

[MITM]
hostname = %APPEND% *.taobao.com, *.tmall.com, *.tao.co, *.tb.cn
