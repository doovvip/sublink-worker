#!name=淘宝历史比价｜分享结构解析版
#!desc=候选测试｜V1.16.1｜优先保留分享REQ请求体结构，避免12字节RESP覆盖诊断结果
#!author=doovvip
#!category=淘宝
#!system=ios
#!version=1.16.1
#!date=2026-08-28

# 不修改主配置；不封IP/QUIC。
# 已确认 h-adashx.ut.taobao.com/upload 在“分享→复制链接”时稳定命中。
# 本版优先展示REQ请求体结构；小RESP不再覆盖面板。

[Panel]
淘宝商品ID探测面板 = title="淘宝历史比价", content="等待分享REQ结构…\n淘宝商品页 → 分享 → 复制链接一次", style=info, script-name=淘宝探测面板, update-interval=1

[Script]
淘宝分享结构.REQ = type=http-request, pattern=^https?:\/\/h-adashx\.ut\.taobao\.com\/upload, requires-body=true, binary-body-mode=true, max-size=-1, timeout=15, script-path=https://raw.githubusercontent.com/doovvip/sublink-worker/main/surge-modules/scripts/taobao_share_deep_probe.surge.js?v=1.16.1, script-update-interval=0
淘宝分享结构.RESP = type=http-response, pattern=^https?:\/\/h-adashx\.ut\.taobao\.com\/upload, requires-body=true, binary-body-mode=true, max-size=-1, timeout=15, script-path=https://raw.githubusercontent.com/doovvip/sublink-worker/main/surge-modules/scripts/taobao_share_deep_probe.surge.js?v=1.16.1, script-update-interval=0
淘宝探测面板 = type=generic, script-path=https://raw.githubusercontent.com/doovvip/sublink-worker/main/surge-modules/scripts/taobao_price_probe_panel.surge.js?v=1.16.1, script-update-interval=0

[MITM]
hostname = %APPEND% h-adashx.ut.taobao.com
