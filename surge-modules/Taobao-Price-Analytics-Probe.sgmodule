#!name=淘宝商品ID探测｜埋点版
#!desc=候选诊断｜不拦截QUIC/AMDC｜仅分析淘宝埋点请求结构并提取商品ID
#!author=doovvip
#!category=调试
#!system=ios
#!version=1.2.0
#!date=2026-08-28

# 只用于定位当前商品ID；测试完成后关闭。
# 不修改请求、不阻断淘宝。
# v1.2 强制刷新脚本缓存；仅通知请求体类型/长度、Content-Type、字段名，不显示字段值、Cookie、Token、请求头或原始正文。

[Script]
淘宝商品ID探测 = type=http-request, pattern=^https?:\/\/h-adashx\.ut\.taobao\.com\/upload, requires-body=true, max-size=-1, timeout=10, script-path=https://raw.githubusercontent.com/doovvip/sublink-worker/main/surge-modules/scripts/taobao_price_analytics_probe.surge.js?v=1.2.0, script-update-interval=0

[MITM]
hostname = %APPEND% h-adashx.ut.taobao.com
