#!name=淘宝商品ID探测｜埋点版
#!desc=候选诊断｜V1.3.0｜不拦截QUIC/AMDC｜面板显示安全诊断结果
#!author=doovvip
#!category=调试
#!system=ios
#!version=1.3.0
#!date=2026-08-28

# 只用于定位当前商品ID；测试完成后关闭。
# 不修改请求、不阻断淘宝。
# v1.3 将诊断结果写入 Surge 信息面板，不再依赖系统通知。

[Panel]
淘宝商品ID探测面板 = title="淘宝商品ID探测", content="等待淘宝埋点请求…\n打开淘宝商品详情页后刷新此面板", style=info, script-name=淘宝探测面板, update-interval=1

[Script]
淘宝商品ID探测 = type=http-request, pattern=^https?:\/\/h-adashx\.ut\.taobao\.com\/upload, requires-body=true, max-size=-1, timeout=10, script-path=https://raw.githubusercontent.com/doovvip/sublink-worker/main/surge-modules/scripts/taobao_price_analytics_probe.surge.js?v=1.3.0, script-update-interval=0
淘宝探测面板 = type=generic, script-path=https://raw.githubusercontent.com/doovvip/sublink-worker/main/surge-modules/scripts/taobao_price_probe_panel.surge.js?v=1.3.0

[MITM]
hostname = %APPEND% h-adashx.ut.taobao.com
