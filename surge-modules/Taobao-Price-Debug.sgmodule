#!name=淘宝比价接口探测｜临时
#!desc=第二阶段诊断｜阻断淘宝直连 QUIC + AMDC 直连分配，强制回落到可识别的 HTTPS 域名
#!author=doovvip
#!category=调试
#!system=ios
#!version=1.1.0
#!date=2026-08-28

# 临时诊断模块：测试完成后关闭/删除。
# 截图已确认新版淘宝大量使用 raw IP + QUIC Port Map，旧商品详情域名规则因此无法命中。
# 本版临时阻断 UDP/443，并阻断 AMDC 直连地址分配，让淘宝回落到 TCP/HTTPS 域名连接。

[Rule]
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT

[URL Rewrite]
^https?:\/\/.+\/amdc\/mobileDispatch - reject

[Script]
淘宝接口探测 = type=http-request, pattern=^https?:\/\/(?:[^\/]+\.)?(?:taobao|tmall)\.com\/, requires-body=false, timeout=10, script-path=https://raw.githubusercontent.com/doovvip/sublink-worker/main/surge-modules/scripts/taobao_price_debug.surge.js, script-update-interval=86400

[MITM]
hostname = %APPEND% *.taobao.com, *.tmall.com
