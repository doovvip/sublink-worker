#!name=哔哩哔哩去广告
#!desc=哔哩哔哩母版｜Surge 原生优化稳定基线｜已实机跑通：完整入口、UI 净化、开屏/推荐/直播/搜索/动态/Proto 去广告正常
#!author=ddgksf2013, BiliUniverse / Surge native optimization
#!category=去广告
#!arguments=Home.Switch:true,Home.Tab:"直播tab,推荐tab,hottopic,bangumi,anime,film,koreavtw",Home.Tab_default:"推荐tab",Home.Top_left:"mine",Home.Top:"消息Top",Bottom:"home,dynamic,ogv,会员购Bottom,我的Bottom",Region.Switch:true,Mine.Switch:true,Mine.iPad.Switch:true,Storage:"Argument",LogLevel:"WARN"
#!system=ios

# ============================================================
# 母版规则
# ============================================================
# 本文件为“哔哩哔哩母版 / 正式基线”。
# 后续所有优化、实验、兼容修改均从本文件派生；未经实机验证不反向覆盖母版。
# 当前母版已由用户实机确认跑通。
# ============================================================

# ============================================================
# 设计思路
# ============================================================
# 1. 不再按 Quantumult X 的“一接口一脚本行”思路机械移植。
# 2. 墨鱼 bilibili.ads.js 本身只使用 $request / $response / $done，
#    已经是 Surge 可直接运行的逻辑，不需要 QX 环境模拟层。
# 3. 同一个 JSON 脚本的多个接口合并为 1 条 Surge http-response 入口。
# 4. BiliUniverse Enhanced 的 Tab / Mine / Region / Channel 合并为 1 条入口；
#    参数与现跑通版保持一致，最全首页与港澳台/动画/韩综/节目入口不变。
# 5. BiliUniverse ADBlock 的 5 个 Proto/gRPC 接口合并为 1 条 binary-body 入口。
# 6. 删除无实际业务价值的 Version/测试拦截项。
# 7. MITM 从大范围 *.bilibili.* / *.biliapi.* 收窄到实际被本模块处理的主机，
#    减少无关 HTTPS 解密，优先稳定与速度。
# 8. 不删现跑通的开屏、推荐、直播、追番、观影、搜索、Mine/Region/Channel、
#    弹幕、动态、UP 推荐等核心功能。
# 9. 当前完整整合稳定版保留不动作为回滚基线；本文件先实机验证再升为正式原版。
# ============================================================

[URL Rewrite]
# 播放页广告接口
^https?:\/\/api\.bilibili\.com\/pgc\/activity\/deliver\/material\/receive - reject-dict
^https?:\/\/api\.bilibili\.com\/x\/vip\/ads\/material\/report - reject-dict
^https:\/\/api\.bilibili\.com\/pgc\/season\/player\/cards - reject-dict
^https?:\/\/api\.bilibili\.com\/pgc\/season\/player\/ogv\/cards - reject-dict

# 开屏
^https:\/\/app\.bilibili\.com\/x\/v2\/splash\/show - reject-dict

# 漫画
^https?:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/(Flash|ListFlash|GetActivityTab) - reject-dict

# 搜索默认推广词 / Proto DefaultWord
^https?:\/\/app\.bilibili\.com\/x\/v\d\/search\/defaultwords - reject-dict
^https?:\/\/(app\.bilibili\.com|grpc\.biliapi\.net)\/bilibili\.app\.interface\.v1\.Search\/Default - reject-200

[Script]
# 墨鱼 JSON：播放页 / 直播 / 开屏 / 画质状态 / 推荐 / 追番 / 观影 / 顶部活动 / 热搜 / 旧 Tab 回退
BiliBili.JSON = type=http-response, pattern=^(?:https?:\/\/api\.(?:biliapi|bilibili)\.(?:net|com)\/pgc\/season\/app\/related\/recommend\?|https?:\/\/api\.live\.bilibili\.com\/xlive\/(?:e-commerce-interface\/v\d\/ecommerce-user\/get_shopping_info\?|app-room\/v1\/index\/getInfoByRoom|app-interface\/v2\/index\/feed)|https?:\/\/app\.bilibili\.com\/x\/(?:v2\/(?:splash\/list|account\/myinfo\?|feed\/index|search\/square)|resource\/top\/activity|resource\/show\/tab(?:\?.*)?$)|https?:\/\/api\.(?:bilibili|biliapi)\.(?:com|net)\/pgc\/page\/(?:bangumi|cinema\/tab\?)), requires-body=true, max-size=-1, timeout=20, script-path=https://raw.githubusercontent.com/doovvip/sublink-worker/main/surge-modules/scripts/bilibili.ads.js

# BiliUniverse Enhanced：完整首页 / Mine / Region / Channel
BiliBili.Enhanced = type=http-response, pattern=^https?:\/\/app\.bili(?:bili\.com|api\.net)\/x\/(?:resource\/show\/tab\/v2|v2\/account\/mine(?:\/ipad)?|v2\/region\/index|v2\/channel\/region\/list)(?:\?.*)?$, requires-body=true, max-size=-1, timeout=15, script-path=https://github.com/BiliUniverse/Enhanced/releases/download/v0.5.13/response.bundle.js, script-update-interval=86400, argument=Home.Switch="{{{Home.Switch}}}"&Home.Tab="{{{Home.Tab}}}"&Home.Tab_default="{{{Home.Tab_default}}}"&Home.Top_left="{{{Home.Top_left}}}"&Home.Top="{{{Home.Top}}}"&Bottom="{{{Bottom}}}"&Region.Switch="{{{Region.Switch}}}"&Mine.Switch="{{{Mine.Switch}}}"&Mine.iPad.Switch="{{{Mine.iPad.Switch}}}"&Storage="{{{Storage}}}"&LogLevel="{{{LogLevel}}}"

# BiliUniverse ADBlock Proto：搜索 / 弹幕 / 青少年 / UP 推荐 / 动态
BiliBili.Proto = type=http-response, pattern=^https?:\/\/(?:grpc\.biliapi\.net|app\.bilibili\.com)\/(?:bilibili\.polymer\.app\.search\.v1\.Search\/SearchAll|bilibili\.community\.service\.dm\.v1\.DM\/(?:DmView|DmSegMobile)|bilibili\.app\.interface\.v1\.Teenagers\/ModeStatus|bilibili\.app\.(?:view|viewunite)\.v1\.View\/(?:View|TFInfo)|bilibili\.app\.dynamic\.v2\.Dynamic\/Dyn(?:All|Video))$, requires-body=true, binary-body-mode=true, max-size=-1, timeout=20, script-path=https://github.com/BiliUniverse/ADBlock/releases/download/v0.6.19/response.bundle.js

[MITM]
hostname = %APPEND% app.bilibili.com, app.biliapi.net, api.bilibili.com, api.bilibili.net, api.biliapi.com, api.biliapi.net, api.live.bilibili.com, manga.bilibili.com, grpc.biliapi.net
