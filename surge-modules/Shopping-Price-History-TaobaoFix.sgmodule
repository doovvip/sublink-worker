#!name=购物历史比价｜淘宝修复测试
#!desc=Surge版｜适配 Surge-1.0｜京东 + 淘宝历史价格｜统一模块
#!author=wf021325 / yichahucha / ddgksf2013 / doovvip integration
#!category=购物
#!system=ios
#!version=1.0.2-test
#!date=2026-08-28

# 测试候选：京东保持原逻辑；淘宝增加阿里旧直连 IP 段拦截，强制回到可 MITM 的域名通道。
# 安装本模块后，请关闭单独的京东历史比价和淘宝历史比价模块，避免重复执行。

[Rule]
# 淘宝商品详情旧直连 IP 段：仅测试候选使用
IP-CIDR,203.119.144.0/23,REJECT,no-resolve
IP-CIDR,203.119.175.0/24,REJECT,no-resolve
IP-CIDR,106.11.162.0/24,REJECT,no-resolve
IP-CIDR,47.102.83.0/24,REJECT,no-resolve

[Script]
京东历史比价 = type=http-response, pattern=^https?:\/\/in\.m\.jd\.com\/product\/graphext\/\d+\.html(?:\?.*)?$, requires-body=true, max-size=-1, timeout=60, script-path=https://raw.githubusercontent.com/doovvip/sublink-worker/main/surge-modules/scripts/jd_price.surge.js, script-update-interval=86400

慢慢买CK增强抓取 = type=http-request, pattern=^https?:\/\/(?:[^\/]+\.)?manmanbuy\.com\/, requires-body=true, max-size=-1, timeout=20, script-path=https://raw.githubusercontent.com/doovvip/sublink-worker/main/surge-modules/scripts/jd_price.surge.js, script-update-interval=86400

淘宝比价.AMDC = type=http-request, pattern=^https?:\/\/.+\/amdc\/mobileDispatch, requires-body=true, max-size=-1, timeout=30, script-path=https://raw.githubusercontent.com/doovvip/sublink-worker/main/surge-modules/scripts/taobao_price.surge.js, script-update-interval=86400

淘宝历史比价 = type=http-response, pattern=^https?:\/\/(?:trade-acs|guide-acs|acs|h5api)\.m\.taobao\.com\/gw\/mtop\.taobao\.detail\.getdetail, requires-body=true, max-size=-1, timeout=30, script-path=https://raw.githubusercontent.com/doovvip/sublink-worker/main/surge-modules/scripts/taobao_price.surge.js, script-update-interval=86400

[MITM]
hostname = %APPEND% in.m.jd.com, *.manmanbuy.com, trade-acs.m.taobao.com, guide-acs.m.taobao.com, acs.m.taobao.com, h5api.m.taobao.com, amdc.m.taobao.com
