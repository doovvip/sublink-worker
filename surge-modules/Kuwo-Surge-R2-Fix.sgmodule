[Script]
kkmusic.vip.01 = type=http-response,pattern=^https?:\/\/searchrecterm\.kuwo\.cn\/recterm\.s,requires-body=true,max-size=-1,timeout=60,engine=webview,script-path=https://ddgksf2013.top/scripts/kkmusic.vip.js,script-update-interval=86400
kkmusic.vip.02 = type=http-response,pattern=^https?:\/\/appi\.kuwo\.cn\/kuwopay\/vip-tab\/page\/cells,requires-body=true,max-size=-1,timeout=60,engine=webview,script-path=https://ddgksf2013.top/scripts/kkmusic.vip.js,script-update-interval=86400
kkmusic.vip.03 = type=http-response,pattern=^https?:\/\/appi\.kuwo\.cn\/kuwopay\/vip-tab\/setting,requires-body=true,max-size=-1,timeout=60,engine=webview,script-path=https://ddgksf2013.top/scripts/kkmusic.vip.js,script-update-interval=86400
kkmusic.vip.04 = type=http-response,pattern=^https?:\/\/musicpay\.kuwo\.cn\/music\.pay\?newver,requires-body=true,max-size=-1,timeout=60,engine=webview,script-path=https://ddgksf2013.top/scripts/kkmusic.vip.js,script-update-interval=86400
kkmusic.vip.05 = type=http-response,pattern=^https?:\/\/[a-z0-9A-Z]+\.(kuwo|lrts)\.(cn|me)\/a\.p,requires-body=true,max-size=-1,timeout=60,engine=webview,script-path=https://ddgksf2013.top/scripts/kkmusic.vip.js,script-update-interval=86400
kkmusic.vip.06 = type=http-response,pattern=^https?:\/\/[a-z0-9A-Z]+\.kuwo\.cn\/audi\.tion,requires-body=true,max-size=-1,timeout=60,engine=webview,script-path=https://ddgksf2013.top/scripts/kkmusic.vip.js,script-update-interval=86400
kkmusic.vip.07 = type=http-response,pattern=^https?:\/\/.*\.kuwo\.cn\/v2\/api\/pay\/vip\/extraVipStatus,requires-body=true,max-size=-1,timeout=60,engine=webview,script-path=https://ddgksf2013.top/scripts/kkmusic.vip.js,script-update-interval=86400
kkmusic.vip.08 = type=http-response,pattern=^https?:\/\/vip1\.kuwo\.cn\/vip\/enc\/user\/vip\?op=ui,requires-body=true,max-size=-1,timeout=60,engine=webview,script-path=https://ddgksf2013.top/scripts/kkmusic.vip.js,script-update-interval=86400
kkmusic.vip.09 = type=http-response,pattern=^https?:\/\/vip1\.kuwo\.cn\/vip\/v2\/userbase\/vip\?op=get,requires-body=true,max-size=-1,timeout=60,engine=webview,script-path=https://ddgksf2013.top/scripts/kkmusic.vip.js,script-update-interval=86400
kkmusic.vip.10 = type=http-response,pattern=^https?:\/\/vip1\.kuwo\.cn\/vip\/v2\/user\/vip\?(uid|op=ui),requires-body=true,max-size=-1,timeout=60,engine=webview,script-path=https://ddgksf2013.top/scripts/kkmusic.vip.js,script-update-interval=86400
kkmusic.vip.11 = type=http-response,pattern=^https?:\/\/vip1\.kuwo\.cn\/vip\/v2\/theme,requires-body=true,max-size=-1,timeout=60,engine=webview,script-path=https://ddgksf2013.top/scripts/kkmusic.vip.js,script-update-interval=86400
kkmusic.vip.12 = type=http-request,pattern=^https?:\/\/musicpay\.kuwo\.cn\/music\.pay\?ui,timeout=60,engine=webview,script-path=https://ddgksf2013.top/scripts/kkmusic.vip.js,script-update-interval=86400
kkmusic.vip.13 = type=http-response,pattern=^https?:\/\/appi\.kuwo\.cn\/kuwopay\/personal\/cells,requires-body=true,max-size=-1,timeout=60,engine=webview,script-path=https://ddgksf2013.top/scripts/kkmusic.vip.js,script-update-interval=86400
kkmusic.vip.14 = type=http-response,pattern=^https?:\/\/[a-z0-9A-Z]+\.kuwo\.cn\/mobi\.s\?f=kwxs,requires-body=true,max-size=-1,timeout=60,engine=webview,script-path=https://ddgksf2013.top/scripts/kkmusic.vip.js,script-update-interval=86400

[MITM]
hostname = %APPEND% *.kuwo.cn, *.lrts.me, mc.tencentmusic.com
