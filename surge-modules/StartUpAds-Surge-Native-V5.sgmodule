#!name=去开屏广告｜实验V5
#!desc=实验 V5｜美图已通过｜V380 Pro 改为“自有广告接口+当前 iOS 广告SDK”双层拦截｜喜马拉雅改用 HTTPDNS 阻断+空响应
#!author=doovvip integration
#!category=去广告
#!system=ios

# ============================================================
# 实验 V5 / 不覆盖稳定母版
# ============================================================
# 基线：StartUpAds-Surge-Native.sgmodule（已实机跑通）。
# 美图秀秀已实机确认去广告成功；V5 只继续攻 V380 Pro / 喜马拉雅。
# 验证通过前不晋升、不覆盖稳定母版。
#
# V380 Pro：
# - 旧版墨鱼没有以“V380”命名的专属规则；早期命中主要来自通用广告联盟规则。
# - V5 不再靠猜 SDK：增加 V380 系列公开抓包命中的 ad.nvdvr.cn/ad/index.php。
# - 同时结合当前隐私政策列出的广告 SDK 做第二层拦截。
# - 只处理广告接口/广告主机，不封 av380.net / nvcam.net 整域，保护摄像头核心功能。
#
# 美图秀秀：
# - 保留公开规则长期使用的 mea.meitudata.com/kaiping。
# - 再补当前常见广告域；不加入会员解锁脚本。
#
# 喜马拉雅：
# - 保留广告域拦截，并补 HTTPDNS 绕过处理。
# - 对 adRealTime / ting / focus 改为返回空 JSON，减少失败后切备用广告源。
# - 保留直接 IP 广告接口兜底；不接管会员、播放解锁等功能。
# ============================================================

# ============================================================
# 设计思路
# ============================================================
# 1. 本模块只做“通用开屏/弹窗广告”处理；不接管 B站、酷我；喜马拉雅仅处理广告链路。
# 2. 不模拟 Quantumult X，不使用 $task / $prefs / $notify，不运行任何 JS。
# 3. 能用 Surge 原生 URL Rewrite 直接拒绝的，直接拒绝。
# 4. 只有必须返回固定 JSON 的接口才使用 Map Local。
# 5. 同域、同返回方式、同业务含义的规则做小范围合并；不使用巨大正则。
# 6. V5 仅为剩余问题增加必要广告 SDK 域和喜马拉雅自身域 MITM；仍不碰登录/支付/设备业务接口。
# 7. 当前跑通版保留为回滚基线；本候选版实机确认后再晋升为母版。
#
# 当前结构：
# - 以已跑通稳定版为底，不删除已验证规则。
# - Script：0 条；QX 兼容层：0。
# - 美图秀秀规则已实机通过，保持不动。
# - B站 / 酷我不由本模块接管。
# - V380 Pro / 喜马拉雅为 V5 针对性实验链路。
# ============================================================

# ============================================================
# V5 核心改法
# ============================================================
# V380 Pro：
# 1. 不再只猜第三方 SDK。公开抓包曾直接命中：
#    http://ad.nvdvr.cn/ad/index.php?...  （V380 系列自有广告接口）
# 2. 公开静态分析还列出广告/内容主机：
#    ad.nvdvr.cn / adwscdn.av380.net / promotionad.nvcam.net / adstatistics.av380.net
# 3. 2026 隐私政策明确 iOS 仍接入穿山甲、快手联盟、腾讯优量汇、Taku、BeiZi/AdScope、极准瑞量、百度联盟等广告 SDK。
# 4. 因此 V5 同时拦“自有广告接口 + iOS 实际广告平台”，但不碰 av380.net/nvcam.net 的设备连接、云录像、登录等核心主机。
#
# 喜马拉雅：
# 1. V4 只拦 ximalaya 域名仍失败，V5 重点转向 HTTPDNS 绕过。
# 2. 阻断 gslbali/gslbtx 的 linkeye-cloud/httpdns，迫使广告请求回到域名链路。
# 3. 对 adRealTime / ting / focus 直接返回空 JSON，而不是单纯网络错误，减少 App 回退到备用广告源。
# 4. 额外保留原社区规则中“直接 IP + adRealTime / outadservice / ting/preload”的兜底匹配。
# ============================================================

[Rule]
# ===== V380 Pro：应用自有广告/内容主机 =====
DOMAIN,adwscdn.av380.net,REJECT
DOMAIN,promotionad.nvcam.net,REJECT
DOMAIN,adstatistics.av380.net,REJECT

# ===== V380 Pro：2026 iOS 隐私政策明确接入的广告平台 =====
# 穿山甲 / Pangle
DOMAIN,ad.zijieapi.com,REJECT
DOMAIN,pangolin.snssdk.com,REJECT
DOMAIN,lf-ad-ies.bytecdn.cn,REJECT
DOMAIN-SUFFIX,byteadverts.com,REJECT

# 快手联盟
DOMAIN,gdfp.gifshow.com,REJECT
DOMAIN,open.e.kuaishou.com,REJECT
DOMAIN,open.e.kuaishou.cn,REJECT
DOMAIN,adtrack.e.kuaishou.com,REJECT
DOMAIN-SUFFIX,partner.gifshow.com,REJECT
DOMAIN-SUFFIX,adukwai.com,REJECT
DOMAIN-SUFFIX,adkwai.com,REJECT

# 腾讯优量汇 / GDT
DOMAIN,adsmind.gdtimg.com,REJECT
DOMAIN,adsmind.ugdtimg.com,REJECT
DOMAIN,pgdt.gtimg.cn,REJECT
DOMAIN,pgdt.ugdtimg.com,REJECT
DOMAIN,qzs.gdtimg.com,REJECT
DOMAIN,sdk.e.qq.com,REJECT
DOMAIN,tangram.e.qq.com,REJECT
DOMAIN-SUFFIX,gdt.qq.com,REJECT
DOMAIN-SUFFIX,ugdtimg.com,REJECT

# Taku / TopOn 兼容层
DOMAIN-SUFFIX,toponadss.com,REJECT
DOMAIN-SUFFIX,motowoo.com,REJECT

# 极准瑞量（V380 Pro 2026 隐私政策明确列出）
DOMAIN-SUFFIX,hzjizhun.cn,REJECT
DOMAIN-SUFFIX,hzjizhun.com,REJECT

# BeiZi / AdScope（V380 Pro 2026 隐私政策明确列出）
DOMAIN-SUFFIX,beizi.biz,REJECT
DOMAIN-SUFFIX,beizi.info,REJECT
DOMAIN-SUFFIX,beizi.online,REJECT
DOMAIN-SUFFIX,ad-scope.com.cn,REJECT
DOMAIN-SUFFIX,adn-plus.com.cn,REJECT
DOMAIN-SUFFIX,adhub.com.cn,REJECT
DOMAIN-SUFFIX,adnplus.com.cn,REJECT
DOMAIN-SUFFIX,adscope.com.cn,REJECT
DOMAIN-SUFFIX,adscope.cn,REJECT
DOMAIN-SUFFIX,adscope.xyz,REJECT

# 百度联盟（V380 Pro 2026 隐私政策明确列出）
DOMAIN,afd.baidu.com,REJECT
DOMAIN,als.baidu.com,REJECT
DOMAIN,mobads-logs.baidu.com,REJECT
DOMAIN,mobads-pre-config.cdn.bcebos.com,REJECT
DOMAIN,mobads.baidu.com,REJECT
DOMAIN,nadvideo2.baidu.com,REJECT
DOMAIN,wn.pos.baidu.com,REJECT
DOMAIN-SUFFIX,union.baidu.cn,REJECT
DOMAIN-SUFFIX,union.baidu.com,REJECT

# ===== V380 Pro：旧墨鱼 AnyThink/TopOn 通用广告中介 =====
DOMAIN-SUFFIX,anythinktech.com,REJECT
# V380 Pro 公开包还确认含 ByteDance/Pangle、Google Ads、Yandex Ads、Bigo、MBridge/Mintegral。
# 这些只拦广告 SDK 域，不碰 av380.net / nvcam.net / 设备业务域。
DOMAIN-SUFFIX,pangolin-sdk-toutiao.com,REJECT
DOMAIN-SUFFIX,pglstatp-toutiao.com,REJECT
DOMAIN-SUFFIX,pangle.io,REJECT
DOMAIN,googleads.g.doubleclick.net,REJECT
DOMAIN,pagead2.googlesyndication.com,REJECT
DOMAIN,mobile.yandexadexchange.net,REJECT
DOMAIN-SUFFIX,bigossp.com,REJECT
DOMAIN-SUFFIX,rayjump.com,REJECT
DOMAIN-SUFFIX,mintegral.com,REJECT

# ===== 美图秀秀：广告域补充 =====
DOMAIN,adui.tg.meitu.com,REJECT
DOMAIN,gg.meitu.com,REJECT
DOMAIN,tuiguang.meitu.com,REJECT
DOMAIN,meitubeauty.meitudata.com,REJECT
DOMAIN,xiuxiu.mobile.meitudata.com,REJECT

# ===== 喜马拉雅：广告域补全 =====
DOMAIN,ad.ximalaya.com,REJECT
DOMAIN,adse.ximalaya.com,REJECT
DOMAIN,adse.wsa.ximalaya.com,REJECT
DOMAIN,adbehavior.ximalaya.com,REJECT
DOMAIN,adbehavior.wsa.ximalaya.com,REJECT
DOMAIN,adbs.ximalaya.com,REJECT
DOMAIN,adsebs.ximalaya.com,REJECT
DOMAIN,xdcs-collector.ximalaya.com,REJECT
DOMAIN,adwbs.ximalaya.com,REJECT
DOMAIN-SUFFIX,adweb.ximalaya.com,REJECT
DOMAIN-SUFFIX,linkeye.ximalaya.com,REJECT

[URL Rewrite]
# ===== 喜马拉雅：阻断 HTTPDNS 绕过 =====
^https?:\/\/(?:gslbali|gslbtx)\.ximalaya\.com\/linkeye-cloud\/httpdns\/ - reject
^https?:\/\/[^\/]+\.ximalaya\.com\/linkeye-cloud\/checkIP(?:\/|\?|$) - reject

# ===== 喜马拉雅：直接 IP 广告兜底 =====
^https?:\/\/(?:\d{1,3}\.){3}\d{1,3}\/api\/v\d+\/adRealTime(?:\/|\?|$) - reject-200
^https?:\/\/(?:\d{1,3}\.){3}\d{1,3}\/(?:outadservice|ting\/preload)(?:\/|\?|$) - reject-200

# ===== 喜马拉雅：开屏 / 实时广告 =====

# ===== 美图秀秀：开屏 =====
^https?:\/\/mea\.meitudata\.com\/kaiping - reject

# ===== 百度网盘 =====
^https?:\/\/pan\.baidu\.com\/(?:act\/v\d+\/(?:bchannel|welfare)\/list|rest\/2\.0\/pcs\/ad) - reject-200

# ===== 山姆会员商店 =====
^https?:\/\/api-sams\.walmartmobile\.cn\/api\/v1\/sams\/sams-user\/(?:window\/getGoUpPlus|screen_promotion\/get) - reject-200

# ===== 淘宝 =====
^https?:\/\/guide-acs\.m\.taobao\.com\/gw\/mtop\.taobao\.wireless\.home\.splash\.awesome\.get - reject-200

# ===== 京东 =====
^https?:\/\/api\.m\.jd\.com\/client\.action\?functionId=(?:start|queryMaterialAdverts) - reject-200
^https?:\/\/(?:bdsp-x|dsp-x)\.jd\.com\/adx\/ - reject-200

# ===== 美团 =====
^https?:\/\/peisongapi\.meituan\.com\/client\/getInitiateImage - reject-200
^https?:\/\/img\.meituan\.net\/(?:adunion|display|midas)\/\w+\.(?:gif|jpg|jpg\.webp)$ - reject-200
^https?:\/\/(?:s3plus|flowplus)\.meituan\.net\/v\d+\/\w+\/linglong\/\w+\.(?:gif|jpg|mp4) - reject-200
^https?:\/\/p\d\.meituan\.net\/(?:(?:bizad|wmbanner)\/\w+\.jpg|movie\/\w+\.jpg\?may_covertWebp) - reject-200

# ===== 闲鱼（备用） =====
^https?:\/\/acs\.m\.goofish\.com\/gw\/mtop[^/]*splash\.ads - reject-200

# ===== 拼多多（备用） =====
^https?:\/\/api\.(?:pinduoduo|yangkeduo)\.com\/api\/cappuccino\/splash - reject-200

# ===== 菜鸟（备用） =====
^https?:\/\/cn-acs\.m\.cainiao\.com\/gw\/mtop\.cainiao\.guoguo\.nbnetflow\.ads\.(?:show|mshow)\.cn\/ - reject-200
^https?:\/\/iyes\.youku\.com\/uts\/v\d+\/start - reject-200

# ===== 飞猪（备用） =====
^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.fliggy\.crm\.screen\.(?:allresource|availablesplashstrategies) - reject-200

# ===== 顺丰（备用） =====
^https?:\/\/ccsp-egmas\.sf-express\.com\/cx-app-base\/base\/app\/appVersion\/detectionUpgrade - reject-200
^https:\/\/ccsp-egmas\.sf-express\.com\/cx-app-base\/base\/app\/ad\/queryAdImages - reject-200
^https?:\/\/shopic\.sf-express\.com\/crm\/mobile\/common\/flashscreen - reject-200

[Map Local]
# ===== V380 Pro：自有广告接口，返回空 JSON，避免失败后回退到下一广告源 =====
^https?:\/\/ad\.nvdvr\.cn\/ad\/index\.php(?:\?.*)?$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# ===== 喜马拉雅：广告接口直接返回空 JSON =====
^https?:\/\/[^\/]+\.ximalaya\.com\/api\/v\d+\/adRealTime(?:\/|\?|$) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?:\/\/[^\/]+\.ximalaya\.com\/ting\/(?:preload|loading|feed|home)(?:\/|\?|$) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?:\/\/[^\/]+\.ximalaya\.com\/discovery-feed\/focus\/queryF(?:\/|\?|$) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# 百度网盘：两个接口都要求返回空 JSON，合并为一个原生 Map Local
^https:\/\/pan\.baidu\.com\/(?:act\/api\/activityentry|buy\/ad\/conf\?.*type=splashMode) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% pan.baidu.com, api-sams.walmartmobile.cn, guide-acs.m.taobao.com, api.m.jd.com, bdsp-x.jd.com, dsp-x.jd.com, peisongapi.meituan.com, img.meituan.net, s3plus.meituan.net, flowplus.meituan.net, p*.meituan.net, acs.m.goofish.com, api.pinduoduo.com, api.yangkeduo.com, cn-acs.m.cainiao.com, iyes.youku.com, acs.m.taobao.com, ccsp-egmas.sf-express.com, shopic.sf-express.com, mea.meitudata.com, *.ximalaya.com, ad.nvdvr.cn
