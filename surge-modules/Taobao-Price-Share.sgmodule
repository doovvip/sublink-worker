#!name=淘宝历史比价｜分享链接版
#!desc=Surge候选版｜不解密淘宝App原生详情接口｜淘宝/天猫分享链接在 Safari 打开时自动查历史价格
#!author=doovvip integration
#!category=淘宝
#!system=ios
#!version=2.0.0-candidate
#!date=2026-08-28

# 使用方式：
# 淘宝商品页 → 分享 → 复制链接 → 把链接粘贴到 Safari 打开。
# Surge 会识别 m.tb.cn / item.taobao.com / detail.tmall.com 等链接并弹出历史价格通知。
# 本版不依赖淘宝 App 的 MITM，因此避开新版淘宝原生详情链路无法被 Surge 脚本命中的问题。
# 历史价格源按顺序尝试：比价狗 -> 慢慢买 -> icharle。

[Script]
淘宝分享链接比价 = type=http-request, pattern=^https?:\/\/(?:m\.tb\.cn|e\.tb\.cn|s\.tb\.cn|[^\/]*\.tb\.cn|item\.taobao\.com|detail\.tmall\.com|detail\.tmall\.hk|h5\.m\.taobao\.com)\/.*, requires-body=false, timeout=30, script-path=https://raw.githubusercontent.com/doovvip/sublink-worker/main/surge-modules/scripts/taobao_price_share.surge.js, script-update-interval=3600

[MITM]
hostname = %APPEND% m.tb.cn, e.tb.cn, s.tb.cn, *.tb.cn, item.taobao.com, detail.tmall.com, detail.tmall.hk, h5.m.taobao.com
